# ============================================================
# CyberGuard - Variables de entorno (copia como .env)
# ============================================================

# --- Aplicación ---
NODE_ENV=development
PORT=3000

# --- Base de datos PostgreSQL ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cyberguard?schema=public"

# --- Autenticación ---
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10

# --- API Key para componentes (IDS, SIEM, Lab) ---
API_KEY=cyberguard_internal_key

# --- CORS ---
CORS_ORIGIN=http://localhost:4200

# --- Scanner ---
SCANNER_PORT_RANGE=1-1000
SCANNER_TIMEOUT_MS=1500
SCANNER_MAX_THREADS=50

# --- CVE API ---
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_API_KEY=

# --- SIEM ---
SIEM_CORRELATION_WINDOW_MS=60000
